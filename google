#!/usr/bin/env python3

import sys
import urllib.parse
import webbrowser

def main():
    if len(sys.argv) < 2:
        print("Usage: google <search query>")
        sys.exit(1)

    query = " ".join(sys.argv[1:])
    encoded_query = urllib.parse.quote_plus(query)
    url = f"https://www.google.com/search?q={encoded_query}"

    webbrowser.open(url)


if __name__ == "__main__":
    main()
